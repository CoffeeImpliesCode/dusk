# direnv loads this file on entering the directory. It puts the host scratch
# policy in place first: on a buildhost host `~/.dev-env.sh` exports TMPDIR and
# the Zig cache directories onto local disk, which Zig 0.16.0 requires because
# this checkout lives on NFS. Outside the cluster that source is a no-op.
export DIRENV_WARN_TIMEOUT=20s

if [ -f "$HOME/.dev-env.sh" ]; then
  source "$HOME/.dev-env.sh"
fi

eval "$(devenv direnvrc)"

# `use devenv` supports the same options as the `devenv shell` command.
#
# To silence the output, use `--quiet`.
#
# Example usage: use devenv --quiet --impure --option services.postgres.enable:bool true
use devenv
