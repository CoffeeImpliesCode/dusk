.{
    // Package name. Consumers depend on this project as `dusk`.
    .name = .dusk,
    .version = "0.0.0",
    // Together with the name, this is the globally unique package identifier.
    // Zig generates it once and it never changes afterwards.
    .fingerprint = 0x19488716d2b9cbc7, // Changing this has security and trust implications.
    // Zig 0.16.0 is the line this project targets, not merely a lower bound.
    // `zig` on this host is an anyzig shim that reads this field, so it is also
    // how the toolchain gets selected: every tool in the gate follows it.
    .minimum_zig_version = "0.16.0",
    // Zero dependencies. The pinned Vulkan headers reach `build.zig` through
    // `DUSK_VULKAN_HEADERS` in devenv, not through the package manager: Zig
    // executes a dependency's own `build.zig` on every configure pass, and
    // `docs/20-dependencies.md` proves the `vulkan-headers` package's
    // `toolbox` glue fails under Zig 0.16.0 (`Build.root` is gone,
    // `findProgram` takes a `paths` argument). The `.paths` filter cannot
    // save it, because the filter selects which files the hash covers, not
    // which files Zig executes. `docs/20-dependencies.md` "Vulkan bindings"
    // owns the pin (`8249cb829eb402c65cb7e3778c51b0f8edc4a4b6`,
    // Vulkan-Headers v1.4.365) and the reason the standard library cannot
    // cover the slot.
    .dependencies = .{},
    // Only these paths are packaged and hashed. Keep it to what a build needs.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "docs",
        "README.md",
        "AGENTS.md",
        "test",
        "tools",
    },
}
